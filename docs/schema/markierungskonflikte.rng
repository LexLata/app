<?xml version='1.0' encoding='utf-8'?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start>
    <element name="markierungskonflikte">
      <attribute name="version">
        <value>1</value>
      </attribute>
      <attribute name="pruefstatus">
        <choice>
          <value>aktuell</value>
          <value>ausstehend</value>
          <value>fehlgeschlagen</value>
        </choice>
      </attribute>
      <zeroOrMore>
        <attribute>
          <anyName>
            <except>
              <name>version</name>
              <name>pruefstatus</name>
            </except>
          </anyName>
          <text />
        </attribute>
      </zeroOrMore>
      <interleave>
        <zeroOrMore>
          <element name="gesetz">
            <attribute name="kurztitel">
              <ref name="nichtleer" />
            </attribute>
            <attribute name="normgeber">
              <ref name="normgeber" />
            </attribute>
            <zeroOrMore>
              <attribute>
                <anyName>
                  <except>
                    <name>kurztitel</name>
                    <name>normgeber</name>
                  </except>
                </anyName>
                <text />
              </attribute>
            </zeroOrMore>
            <interleave>
              <group>
                <optional>
                  <element name="konflikt">
                    <attribute name="typ">
                      <choice>
                        <value>gesetz-fehlt</value>
                        <value>nichtamtliche-titel-xml-fehlt</value>
                      </choice>
                    </attribute>
                    <zeroOrMore>
                      <attribute>
                        <anyName>
                          <except>
                            <name>typ</name>
                          </except>
                        </anyName>
                        <text />
                      </attribute>
                    </zeroOrMore>
                    <empty />
                  </element>
                </optional>
                <zeroOrMore>
                  <choice>
                    <element name="unterstreichung">
                      <ref name="markierungskonflikt" />
                    </element>
                    <element name="hervorhebung">
                      <ref name="markierungskonflikt" />
                    </element>
                    <element name="kommentar">
                      <ref name="markierungskonflikt" />
                    </element>
                    <element name="verweismarkierung">
                      <ref name="markierungskonflikt" />
                    </element>
                  </choice>
                </zeroOrMore>
              </group>
              <zeroOrMore>
                <element>
                  <anyName>
                    <except>
                      <name>konflikt</name>
                      <name>unterstreichung</name>
                      <name>hervorhebung</name>
                      <name>kommentar</name>
                      <name>verweismarkierung</name>
                    </except>
                  </anyName>
                  <ref name="anyContent" />
                </element>
              </zeroOrMore>
            </interleave>
          </element>
        </zeroOrMore>
        <zeroOrMore>
          <element>
            <anyName>
              <except>
                <name>gesetz</name>
              </except>
            </anyName>
            <ref name="anyContent" />
          </element>
        </zeroOrMore>
      </interleave>
    </element>
  </start>
  <define name="nichtleer">
    <data type="token">
      <param name="minLength">1</param>
    </data>
  </define>
  <define name="normgeber">
    <data type="string">
      <param name="pattern">[a-z0-9]+(-[a-z0-9]+)*</param>
      <param name="maxLength">20</param>
    </data>
  </define>
  <define name="number">
    <data type="string">
      <param name="pattern">[0-9]+</param>
    </data>
  </define>
  <define name="positive">
    <data type="string">
      <param name="pattern">[1-9][0-9]*</param>
    </data>
  </define>
  <define name="anyContent">
    <zeroOrMore>
      <attribute>
        <anyName />
        <text />
      </attribute>
    </zeroOrMore>
    <mixed>
      <zeroOrMore>
        <element>
          <anyName />
          <ref name="anyContent" />
        </element>
      </zeroOrMore>
    </mixed>
  </define>
  <define name="gesetzRef">
    <element name="gesetz">
      <attribute name="normgeber">
        <ref name="normgeber" />
      </attribute>
      <zeroOrMore>
        <attribute>
          <anyName>
            <except>
              <name>normgeber</name>
            </except>
          </anyName>
          <text />
        </attribute>
      </zeroOrMore>
      <ref name="nichtleer" />
    </element>
  </define>
  <define name="gliederungskennzahl">
    <element name="gliederungskennzahl">
      <zeroOrMore>
        <attribute>
          <anyName>
            <except>
              <name>praefix</name>
            </except>
          </anyName>
          <text />
        </attribute>
      </zeroOrMore>
      <data type="string">
        <param name="pattern">([0-9]{3})+</param>
      </data>
    </element>
  </define>
  <define name="ausgangsstelle">
    <choice>
      <element name="bezeichnung">
        <ref name="nichtleer" />
      </element>
      <ref name="gliederungskennzahl" />
    </choice>
  </define>
  <define name="bezeichnung">
    <element name="bezeichnung">
      <ref name="nichtleer" />
    </element>
  </define>
  <define name="zeichenbereich">
    <element name="zeichenbereich">
      <attribute name="start">
        <ref name="number" />
      </attribute>
      <attribute name="ende">
        <ref name="number" />
      </attribute>
      <zeroOrMore>
        <attribute>
          <anyName>
            <except>
              <name>start</name>
              <name>ende</name>
            </except>
          </anyName>
          <text />
        </attribute>
      </zeroOrMore>
      <empty />
    </element>
  </define>
  <define name="verweistextZeichenbereich">
    <element name="verweistextZeichenbereich">
      <attribute name="start">
        <ref name="number" />
      </attribute>
      <attribute name="ende">
        <ref name="number" />
      </attribute>
      <zeroOrMore>
        <attribute>
          <anyName>
            <except>
              <name>start</name>
              <name>ende</name>
            </except>
          </anyName>
          <text />
        </attribute>
      </zeroOrMore>
      <empty />
    </element>
  </define>
  <define name="textstelle">
    <element name="textstelle">
      <zeroOrMore>
        <attribute>
          <anyName />
          <text />
        </attribute>
      </zeroOrMore>
      <interleave>
        <group>
          <choice>
            <group>
              <optional>
                <element name="absatz">
                  <zeroOrMore>
                    <attribute>
                      <anyName>
                        <except>
                          <name>wiederholung</name>
                        </except>
                      </anyName>
                      <text />
                    </attribute>
                  </zeroOrMore>
                  <choice>
                    <group>
                      <optional>
                        <attribute name="wiederholung">
                          <data type="nonNegativeInteger" />
                        </attribute>
                      </optional>
                      <ref name="nichtleer" />
                    </group>
                    <group>
                      <attribute name="wiederholung">
                        <data type="nonNegativeInteger" />
                      </attribute>
                      <empty />
                    </group>
                  </choice>
                </element>
              </optional>
              <optional>
                <element name="unterabsatz">
                  <zeroOrMore>
                    <attribute>
                      <anyName />
                      <text />
                    </attribute>
                  </zeroOrMore>
                  <ref name="nichtleer" />
                </element>
              </optional>
              <choice>
                <group>
                  <optional>
                    <element name="satz">
                      <zeroOrMore>
                        <attribute>
                          <anyName />
                          <text />
                        </attribute>
                      </zeroOrMore>
                      <ref name="positive" />
                    </element>
                  </optional>
                  <oneOrMore>
                    <choice>
                      <element name="nummer">
                        <optional>
                          <attribute name="wiederholung">
                            <ref name="positive" />
                          </attribute>
                        </optional>
                        <zeroOrMore>
                          <attribute>
                            <anyName>
                              <except>
                                <name>wiederholung</name>
                              </except>
                            </anyName>
                            <text />
                          </attribute>
                        </zeroOrMore>
                        <ref name="nichtleer" />
                      </element>
                      <element name="litera">
                        <optional>
                          <attribute name="wiederholung">
                            <ref name="positive" />
                          </attribute>
                        </optional>
                        <zeroOrMore>
                          <attribute>
                            <anyName>
                              <except>
                                <name>wiederholung</name>
                              </except>
                            </anyName>
                            <text />
                          </attribute>
                        </zeroOrMore>
                        <ref name="nichtleer" />
                      </element>
                    </choice>
                  </oneOrMore>
                  <optional>
                    <element name="satz">
                      <zeroOrMore>
                        <attribute>
                          <anyName />
                          <text />
                        </attribute>
                      </zeroOrMore>
                      <ref name="positive" />
                    </element>
                  </optional>
                </group>
                <optional>
                  <element name="satz">
                    <zeroOrMore>
                      <attribute>
                        <anyName />
                        <text />
                      </attribute>
                    </zeroOrMore>
                    <ref name="positive" />
                  </element>
                </optional>
              </choice>
            </group>
            <element name="bereich">
              <zeroOrMore>
                <attribute>
                  <anyName />
                  <text />
                </attribute>
              </zeroOrMore>
              <choice>
                <value>amtlicher-titel</value>
                <value>nichtamtlicher-titel</value>
                <value>bezeichnung</value>
              </choice>
            </element>
          </choice>
          <ref name="zeichenbereich" />
        </group>
        <zeroOrMore>
          <element>
            <anyName>
              <except>
                <name>absatz</name>
                <name>unterabsatz</name>
                <name>satz</name>
                <name>nummer</name>
                <name>litera</name>
                <name>bereich</name>
                <name>zeichenbereich</name>
              </except>
            </anyName>
            <ref name="anyContent" />
          </element>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="markierungskonflikt">
    <zeroOrMore>
      <attribute>
        <anyName>
          <except>
            <name>typ</name>
          </except>
        </anyName>
        <text />
      </attribute>
    </zeroOrMore>
    <interleave>
      <group>
        <oneOrMore>
          <choice>
            <element name="konflikt">
              <attribute name="typ">
                <choice>
                  <value>bezugstext-fehlt-oder-unpassend</value>
                  <value>pauschaler-bezug-fehlt</value>
                  <value>pauschaler-bezug-unpassend</value>
                </choice>
              </attribute>
              <zeroOrMore>
                <attribute>
                  <anyName>
                    <except>
                      <name>gesetz</name>
                      <name>normgeber</name>
                      <name>typ</name>
                    </except>
                  </anyName>
                  <text />
                </attribute>
              </zeroOrMore>
              <empty />
            </element>
            <element name="konflikt">
              <attribute name="typ">
                <choice>
                  <value>ziel-gesetz-fehlt</value>
                  <value>ziel-norm-unpassend</value>
                  <value>ziel-norm-fehlt</value>
                </choice>
              </attribute>
              <attribute name="gesetz">
                <ref name="nichtleer" />
              </attribute>
              <attribute name="normgeber">
                <ref name="normgeber" />
              </attribute>
              <zeroOrMore>
                <attribute>
                  <anyName>
                    <except>
                      <name>gesetz</name>
                      <name>normgeber</name>
                      <name>typ</name>
                    </except>
                  </anyName>
                  <text />
                </attribute>
              </zeroOrMore>
              <empty />
            </element>
          </choice>
        </oneOrMore>
        <ref name="ausgangsstelle" />
        <choice>
          <ref name="textstelle" />
          <element name="kommentartext">
            <zeroOrMore>
              <attribute>
                <anyName />
                <text />
              </attribute>
            </zeroOrMore>
            <text />
          </element>
          <element name="verweistext">
            <zeroOrMore>
              <attribute>
                <anyName />
                <text />
              </attribute>
            </zeroOrMore>
            <text />
          </element>
        </choice>
      </group>
      <zeroOrMore>
        <element>
          <anyName>
            <except>
              <name>konflikt</name>
              <name>bezeichnung</name>
              <name>gliederungskennzahl</name>
              <name>markierungstyp</name>
              <name>textstelle</name>
              <name>kommentartext</name>
              <name>text</name>
              <name>verweistext</name>
            </except>
          </anyName>
          <ref name="anyContent" />
        </element>
      </zeroOrMore>
    </interleave>
  </define>
</grammar>
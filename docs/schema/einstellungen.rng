<?xml version="1.0" ?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start>
    <element name="einstellungen">
      <interleave>
        <zeroOrMore>
          <attribute>
            <anyName>
              <except>
                <name>version</name>
              </except>
            </anyName>
            <text/>
          </attribute>
        </zeroOrMore>
        <attribute name="version">
          <value>1</value>
        </attribute>
        <element name="verarbeitungszeit">
          <interleave>
            <zeroOrMore>
              <attribute>
                <anyName/>
                <text/>
              </attribute>
            </zeroOrMore>
            <data type="dateTime"/>
          </interleave>
        </element>
        <optional>
          <element name="farbschema">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="appAkzentfarbe">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="gesetzestextAkzentfarbe">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="hervorhebungsfarbe">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="schriftgroesse">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="leistenSchriftgroesse">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="schriftart">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="zeilenabstand">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="satzNeuZeile">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="blocksatz">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="silbentrennung">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="randbreite">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="strukturKontextLeisteGroesse">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="lesbareZeilenlaenge">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="lesbareZeilenlaengeBreite">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="uiGroesse">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="markierungenDeaktiviert">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="minimalistischerModus">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional><element name="euFassung"><choice><value>konsolidiert</value><value>original</value><value>konsolidiert-mit-erwaegungsgruenden</value></choice></element></optional>
        <optional><element name="euDurchfuehrungsaktSuche"><choice><value>true</value><value>false</value></choice></element></optional>
        <optional>
          <element name="nachbereitungBeiImport">
            <choice>
              <value>aus</value>
              <value>verweise</value>
              <value>saetze</value>
              <value>saetze-und-verweise</value>
            </choice>
          </element>
        </optional>
        <optional>
          <element name="seitenleistenTastenkuerzel">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <choice>
                <value>true</value>
                <value>false</value>
              </choice>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="autoAktualisierungIntervall">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="linuxTitelleistenPraeferenz">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="plattformfremdeUiAnzeigen">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="zitatAbkuerzungenAktiv">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="zitatOhnePunkt">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="zitatRoemischeAbsaetze">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="leistenTauschen">
            <interleave>
              <zeroOrMore>
                <attribute>
                  <anyName/>
                  <text/>
                </attribute>
              </zeroOrMore>
              <text/>
            </interleave>
          </element>
        </optional>
        <optional>
          <element name="appUpdatesAutomatischSuchen"><choice><value>true</value><value>false</value></choice></element>
        </optional>
        <zeroOrMore>
          <element>
            <anyName>
              <except>
                <name>verarbeitungszeit</name>
                <name>farbschema</name>
                <name>appAkzentfarbe</name>
                <name>gesetzestextAkzentfarbe</name>
                <name>hervorhebungsfarbe</name>
                <name>schriftgroesse</name>
                <name>leistenSchriftgroesse</name>
                <name>schriftart</name>
                <name>zeilenabstand</name>
                <name>satzNeuZeile</name>
                <name>blocksatz</name>
                <name>silbentrennung</name>
                <name>randbreite</name>
                <name>strukturKontextLeisteGroesse</name>
                <name>lesbareZeilenlaenge</name>
                <name>lesbareZeilenlaengeBreite</name>
                <name>uiGroesse</name>
                <name>markierungenDeaktiviert</name>
                <name>minimalistischerModus</name>
                <name>nachbereitungBeiImport</name>
                <name>euFassung</name>
                <name>euDurchfuehrungsaktSuche</name>
                <name>seitenleistenTastenkuerzel</name>
                <name>autoAktualisierungIntervall</name>
                <name>linuxTitelleistenPraeferenz</name>
                <name>plattformfremdeUiAnzeigen</name>
                <name>zitatAbkuerzungenAktiv</name>
                <name>zitatOhnePunkt</name>
                <name>zitatRoemischeAbsaetze</name>
                <name>leistenTauschen</name>
                <name>appUpdatesAutomatischSuchen</name>
              </except>
            </anyName>
            <ref name="extensionContent"/>
          </element>
        </zeroOrMore>
      </interleave>
    </element>
  </start>
  <define name="extensionContent">
    <zeroOrMore>
      <attribute>
        <anyName/>
        <text/>
      </attribute>
    </zeroOrMore>
    <mixed>
      <zeroOrMore>
        <element>
          <anyName/>
          <ref name="extensionContent"/>
        </element>
      </zeroOrMore>
    </mixed>
  </define>
</grammar>

<?xml version="1.0" ?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start>
    <element name="nichtamtlicheTitel">
      <interleave>
        <zeroOrMore>
          <attribute>
            <anyName>
              <except>
                <name>version</name>
              </except>
            </anyName>
            <text/>
          </attribute>
        </zeroOrMore>
        <attribute name="version">
          <value>1</value>
        </attribute>
        <element name="infos">
          <interleave>
            <zeroOrMore>
              <attribute>
                <anyName/>
                <text/>
              </attribute>
            </zeroOrMore>
            <element name="gesetz">
              <interleave>
                <zeroOrMore>
                  <attribute>
                    <anyName>
                      <except>
                        <name>normgeber</name>
                      </except>
                    </anyName>
                    <text/>
                  </attribute>
                </zeroOrMore>
                <attribute name="normgeber">
                  <data type="string">
                    <param name="pattern">[a-z0-9]+(-[a-z0-9]+)*</param>
                    <param name="maxLength">20</param>
                  </data>
                </attribute>
                <data type="token">
                  <param name="minLength">1</param>
                </data>
              </interleave>
            </element>
            <optional>
              <element name="geaendert">
                <interleave>
                  <zeroOrMore>
                    <attribute>
                      <anyName/>
                      <text/>
                    </attribute>
                  </zeroOrMore>
                  <data type="dateTime"/>
                </interleave>
              </element>
            </optional>
            <zeroOrMore>
              <element>
                <anyName>
                  <except>
                    <name>gesetz</name>
                    <name>geaendert</name>
                  </except>
                </anyName>
                <ref name="extensionContent"/>
              </element>
            </zeroOrMore>
          </interleave>
        </element>
        <element name="inhalt">
          <interleave>
            <zeroOrMore>
              <attribute>
                <anyName/>
                <text/>
              </attribute>
            </zeroOrMore>
            <zeroOrMore>
              <element name="norm">
                <interleave>
                  <zeroOrMore>
                    <attribute>
                      <anyName/>
                      <text/>
                    </attribute>
                  </zeroOrMore>
                  <element name="bezeichnung">
                    <interleave>
                      <zeroOrMore>
                        <attribute>
                          <anyName/>
                          <text/>
                        </attribute>
                      </zeroOrMore>
                      <data type="token">
                        <param name="minLength">1</param>
                      </data>
                    </interleave>
                  </element>
                  <element name="titel">
                    <interleave>
                      <zeroOrMore>
                        <attribute>
                          <anyName/>
                          <text/>
                        </attribute>
                      </zeroOrMore>
                      <text/>
                    </interleave>
                  </element>
                  <zeroOrMore>
                    <element>
                      <anyName>
                        <except>
                          <name>bezeichnung</name>
                          <name>titel</name>
                        </except>
                      </anyName>
                      <ref name="extensionContent"/>
                    </element>
                  </zeroOrMore>
                </interleave>
              </element>
            </zeroOrMore>
            <zeroOrMore>
              <element>
                <anyName>
                  <except>
                    <name>norm</name>
                  </except>
                </anyName>
                <ref name="extensionContent"/>
              </element>
            </zeroOrMore>
          </interleave>
        </element>
        <zeroOrMore>
          <element>
            <anyName>
              <except>
                <name>infos</name>
                <name>inhalt</name>
              </except>
            </anyName>
            <ref name="extensionContent"/>
          </element>
        </zeroOrMore>
      </interleave>
    </element>
  </start>
  <define name="extensionContent">
    <zeroOrMore>
      <attribute>
        <anyName/>
        <text/>
      </attribute>
    </zeroOrMore>
    <mixed>
      <zeroOrMore>
        <element>
          <anyName/>
          <ref name="extensionContent"/>
        </element>
      </zeroOrMore>
    </mixed>
  </define>
</grammar>
